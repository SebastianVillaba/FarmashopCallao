PORT=4000
CORS_ORIGIN=http://localhost:3000
DB_IP_LAN=
DB_NAME=farmashop
DB_USER=
DB_PASSWORD=
DB_PORT=1433
IMAGES_DIR=C:\FarmaShop\Imagenes\webp
DELIVERY_COSTO=15000
# Panel administrativo
# Secreto para firmar la sesión (mín. 32 caracteres aleatorios). Generar con:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=
# Carpeta para los banners subidos desde el panel (por defecto: junto a IMAGES_DIR, en "banners")
BANNERS_DIR=
# En producción poner NODE_ENV=production para que la cookie del panel sea Secure (requiere HTTPS)
NODE_ENV=development
